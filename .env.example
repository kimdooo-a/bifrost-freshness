# --- Bifrost gateway -------------------------------------------------------
BIFROST_URL=http://localhost:8080
# Admin account seeded by bifrost/config.json (governance.auth_config).
# Used for the management API: GET /api/logs and /api/governance/virtual-keys.
BIFROST_ADMIN_USERNAME=admin
BIFROST_ADMIN_PASSWORD=change-me
# Alternative before an admin account exists: the setup token.
# BIFROST_SETUP_TOKEN=

# Virtual key the auditor uses for its own LLM calls (value must start with sk-bf-).
FRESHNESS_VK=sk-bf-change-me-auditor
FRESHNESS_VK_ID=vk-freshness-auditor
# Only read by bifrost/config.json (demo app traffic, tiny-cap demo key).
DEMO_APP_VK=sk-bf-change-me-demo-app
FRESHNESS_TINY_VK=sk-bf-change-me-tiny
OLLAMA_URL=http://localhost:11434

# --- Auditor models (all served by Bifrost) --------------------------------
FRESHNESS_PRIMARY_MODEL=ollama/gemma4:26b-a4b-chat
FRESHNESS_FALLBACK_MODELS=ollama/gemma4:e4b-it-q4km-chat

# --- Tavily ------------------------------------------------------------------
# Either the key itself or a path to a file that contains it.
TAVILY_API_KEY=
# TAVILY_API_KEY_FILE=/path/to/tavily.key
TAVILY_MAX_CALLS=40
TAVILY_LEDGER=.tavily-usage.json

# Optional: pin the reference date used in prompts (YYYY-MM-DD).
# FRESHNESS_TODAY=
